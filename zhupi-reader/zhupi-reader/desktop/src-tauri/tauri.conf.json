{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "朱批",
  "version": "1.0.0",
  "identifier": "com.jiayan.zhupi",
  "build": {
    "frontendDist": "../../app"
  },
  "app": {
    "windows": [
      {
        "title": "朱批",
        "width": 880,
        "height": 1000,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["epub"],
        "name": "EPUB",
        "description": "EPUB 电子书",
        "role": "Viewer",
        "mimeType": "application/epub+zip"
      }
    ]
  }
}
